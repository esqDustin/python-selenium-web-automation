.cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
.tox/
nosetests.xml
coverage.xml
*.cover

# Environments & Virtualization
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

